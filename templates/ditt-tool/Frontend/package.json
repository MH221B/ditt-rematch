{
  "name": "ditt-tool-frontend",
  "version": "1.0.0",
  "scripts": {
    "build": "ng build --configuration production --output-hashing none && node concat-build.js",
    "start": "npm run build && lite-server --baseDir preview",
    "watch": "nodemon --watch src --ext ts,html,scss --exec \"npm run start\""
  },
  "dependencies": {
    "@angular/common": "^17.0.0",
    "@angular/core": "^17.0.0",
    "@angular/elements": "^17.0.0",
    "@angular/forms": "^17.0.0",
    "@angular/platform-browser": "^17.0.0",
    "rxjs": "~7.8.0",
    "zone.js": "~0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.0.0",
    "@angular/cli": "^17.0.0",
    "@angular/compiler": "^17.0.0",
    "@angular/compiler-cli": "^17.0.0",
    "concat": "^1.0.3",
    "fs-extra": "^11.1.1",
    "lite-server": "^2.6.1",
    "nodemon": "^3.0.0",
    "typescript": "~5.2.2"
  }
}
