<Project Sdk="Microsoft.NET.Sdk">
  
  <ItemGroup>
    <ProjectReference Include="..\..\backend\DITT.Core\DITT.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Package Metadata -->
    <PackageId>DITT.SDK</PackageId>
    <Version>1.0.0</Version>
    <Authors>YourName</Authors>
    <Description>SDK for building DITT tool plugins</Description>
    <PackageTags>ditt;plugins;sdk;tools</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- XML docs for IntelliSense -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  
</Project>
